{
	"name": "prosoche",
	"private": false,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:vault": "VAULT_PATH=$VAULT_PATH vitest run",
		"e2e": "playwright test"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/better-sqlite3": "^9.6.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^5.0.1"
	},
	"dependencies": {
		"@fontsource-variable/source-serif-4": "^5.3.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"better-sqlite3": "^13.0.3",
		"chokidar": "^5.0.0",
		"gray-matter": "^4.0.3",
		"marked": "^18.0.13",
		"node-ical": "^0.27.2",
		"simple-git": "^3.36.0"
	},
	"license": "MIT",
	"description": "A markdown-first daily planner and project hub that reads and writes an Obsidian vault."
}
