#!/bin/bash
# Pull-based deploy: if origin/main moved and CI passed on it, build, restart,
# health-check, roll back on failure. `--force` skips the CI check and the
# "nothing moved" check. Installed at /usr/local/bin/prosoche-deploy on the
# container; the copy in the repo is what to edit (see docs/deploy.md).
set -uo pipefail
REPO=/srv/prosoche/repo; LOG=/var/log/prosoche-deploy.log
GITHUB_REPO=E-gonito/prosoche; GATE=/var/lib/prosoche-deploy.gate
log(){ echo "$(date "+%F %T") $*" | tee -a "$LOG"; }

# What CI says about a commit: success, failure (or any other conclusion),
# queued, in_progress, none (no run yet) or unknown (GitHub unreachable).
# The newest run of the job named `ci` counts, so a re-run replaces a red one.
ci_verdict(){
  curl -fsS --max-time 15 -H 'Accept: application/vnd.github+json' \
    "https://api.github.com/repos/$GITHUB_REPO/commits/$1/check-runs?check_name=ci" 2>/dev/null | python3 -c '
import json, sys
try:
    runs = json.load(sys.stdin)["check_runs"]
except Exception:
    print("unknown"); sys.exit()
if not runs:
    print("none"); sys.exit()
run = max(runs, key=lambda r: r["id"])
print(run["conclusion"] if run["status"] == "completed" else run["status"])' || echo unknown
}

cd "$REPO" || exit 1
runuser -u app -- git fetch -q origin main || { log "fetch failed"; exit 1; }
local=$(git rev-parse HEAD); remote=$(git rev-parse origin/main)
if [[ "$local" == "$remote" && -d build && "${1:-}" != "--force" ]]; then exit 0; fi

if [[ "${1:-}" != "--force" ]]; then
  verdict=$(ci_verdict "$remote")
  if [[ "$verdict" != success ]]; then
    # One line per commit and verdict, not one every two minutes.
    if [[ "$(cat "$GATE" 2>/dev/null)" != "$remote $verdict" ]]; then
      echo "$remote $verdict" > "$GATE"
      case "$verdict" in
        none|queued|in_progress) log "waiting for CI on ${remote:0:7} ($verdict)" ;;
        unknown) log "could not read CI for ${remote:0:7}; not deploying (use --force to skip the check)" ;;
        *) log "CI $verdict on ${remote:0:7}; not deploying" ;;
      esac
    fi
    exit 0
  fi
fi

log "deploying ${remote:0:7} (was ${local:0:7})"
rm -rf build.prev; [[ -d build ]] && cp -a build build.prev
if runuser -u app -- bash -c "git reset -q --hard origin/main && npm ci --no-audit --no-fund --silent && npm run build --silent" >>"$LOG" 2>&1; then
  systemctl restart prosoche; sleep 3
  if curl -fsS -o /dev/null --max-time 10 http://127.0.0.1:3100/; then log "OK ${remote:0:7} live"; rm -rf build.prev; exit 0; fi
  log "health check failed after deploy"
else
  log "build failed"
fi
if [[ -d build.prev ]]; then rm -rf build; mv build.prev build; runuser -u app -- git reset -q --hard "$local"; systemctl restart prosoche; log "rolled back to ${local:0:7}"; fi
exit 1
